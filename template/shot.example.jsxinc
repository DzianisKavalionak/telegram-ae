/* Example coordinates from the first screenshot, NOT a mapping for a new shot.
   Prepare shot.jsxinc with mappingStatus: measured and the user-selected rows. */
(function () {
    var settings = {
        name: "TELEGRAM_3D_KEYLIGHT_V3",
        width: 3840, height: 2160, fps: 25, duration: 6,
        // Optional voiceover: measure decoded duration first, choose total duration accordingly.
        // audio: {file: "assets/voiceover.mp3", startFrame: 15, duration: 8},
        screenshot: "assets/feed_green.png", background: "assets/telegram_background.png",
        expectedWidth: 3840, expectedHeight: 5760,
        screenColour: [0, 1, 0, 1],
        feed: {
            // Для одиночной карточки: scrollEnabled: false, а при отсутствии профиля profile.enabled: false.
            // endFocusY задаёт постоянную точку кадрирования; sceneBlur.clearAt задаётся отдельно.
            crop: [660, 0, 1500, 5760], width: 1800,
            center: [1340, 1080, 0],
            startFocusY: 620, endFocusY: 2735,
            scrollStart: 0, scrollEnd: 2.8,
            // Original screenshot coordinates; inset protects opaque interiors.
            protect: [
                [834, 0, 1290, 108, 40],
                [834, 146, 1290, 651, 40],
                [834, 835, 1290, 1533, 40],
                [834, 2406, 1290, 2037, 40],
                [834, 4481, 1290, 210, 40],
                [834, 4729, 1290, 1031, 40]
            ]
        },
        profile: {
            enabled: true, crop: [2190, 2100, 990, 1050], width: 1120,
            center: [2820, 1028, 130],
            protect: [[2228, 2150, 908, 946, 40]]
        },
        camera: {
            zoom: 5200, startMagnification: 0.96, endMagnification: 1.04,
            startRotation: [1.1, -2.5, -0.3], endRotation: [0, 0.8, 0],
            depthOfField: false, aperture: 12, blurLevel: 50
        },
        background3D: {
            depth: 1000, overscan: 1.25,
            startRotation: [0.5, -1.0, -0.6], endRotation: [-0.5, 1.0, 0.6]
        },
        sceneBlur: {enabled: true, radius: 4, holdUntil: 1.9, clearAt: 2.8},
        shadow: {enabled: true, opacity: 14, distance: 5, softness: 18},
        motionBlur: true
    };

    settings.mappingStatus = "example";
    return {settings: settings, highlights: []};
}());
